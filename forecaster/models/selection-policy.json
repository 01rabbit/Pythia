{
  "_schema_version": "1.0",
  "policy_version": "tactical-selection-v1",
  "weights": {
    "event_probability": 1.0,
    "consequence": 1.0,
    "lead_time_value": 1.0,
    "actionability": 1.0,
    "novelty": 1.0
  },
  "rubric": {
    "consequence": {"low": 0.25, "medium": 0.5, "high": 0.75, "critical": 1.0},
    "lead_time_value": {"none": 0.0, "low": 0.25, "medium": 0.5, "high": 1.0},
    "actionability": {"none": 0.0, "monitor": 0.25, "prepare": 0.5, "act": 1.0},
    "novelty": {"duplicate": 0.0, "update": 0.25, "new": 1.0}
  },
  "formula": "probability * consequence * lead_time_value * actionability * novelty",
  "governance": "LLMによる自由採点禁止。変更はPRと次の検証窓から適用。"
}
