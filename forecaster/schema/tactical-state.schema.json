{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pythia Tactical State File",
  "type": "object",
  "required": [
    "_schema_version",
    "_as_of_date",
    "_cutoff_at_utc",
    "states"
  ],
  "additionalProperties": true,
  "properties": {
    "_schema_version": {
      "const": "2.0"
    },
    "_as_of_date": {
      "type": "string",
      "format": "date"
    },
    "_cutoff_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "_input_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "state_id",
          "subject_type",
          "subject_id",
          "as_of_utc",
          "current_state",
          "state_confidence",
          "observation_ids"
        ],
        "additionalProperties": true,
        "properties": {
          "state_id": {
            "type": "string"
          },
          "subject_type": {
            "enum": [
              "vulnerability",
              "campaign",
              "actor",
              "infrastructure"
            ]
          },
          "subject_id": {
            "type": "string"
          },
          "as_of_utc": {
            "type": "string",
            "format": "date-time"
          },
          "current_state": {
            "type": "string"
          },
          "state_confidence": {
            "enum": [
              "confirmed",
              "probable",
              "uncertain"
            ]
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "basis_event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "basis_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counterevidence_event_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "state_model_version": {
            "type": "string"
          },
          "post_exploit_evidence": {
            "type": "boolean",
            "description": "同一subjectに侵入後 tactic の Technique 証拠があるか。★状態の昇格には使わない（TF-1 の状態は exploitation_stage の明示値だけから導く）。戦況説明・追加収集の補助シグナルとして保持する。"
          },
          "known_targets": {
            "type": "object"
          },
          "known_techniques": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "_contradictory_same_day_states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
