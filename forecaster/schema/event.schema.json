{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pythia Observation Event File",
  "type": "object",
  "required": ["_schema_version", "_event_date", "events"],
  "additionalProperties": true,
  "properties": {
    "_schema_version": {"const": "2.0"},
    "_event_date": {"type": "string", "format": "date"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "event_type", "event_time", "available_at_utc", "subject_refs", "evidence_ids", "assertion_status", "claim_fingerprint", "cohort"],
        "additionalProperties": false,
        "properties": {
          "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{16}$"},
          "event_type": {"enum": ["VULNERABILITY_DISCLOSED", "TECHNICAL_DETAIL_PUBLISHED", "POC_PUBLISHED", "SCANNING_OBSERVED", "EXPLOITATION_LIMITED", "EXPLOITATION_CONFIRMED", "POST_EXPLOIT_ACTIVITY", "CAMPAIGN_BROADENED", "TARGETING_OBSERVED", "INFRASTRUCTURE_OBSERVED", "INFRASTRUCTURE_CHANGED", "CREDENTIAL_ACCESS", "LATERAL_MOVEMENT", "COLLECTION", "EXFILTRATION", "IMPACT", "ATTRIBUTION_CLAIMED", "INSTITUTIONAL_PUBLICATION", "THREAT_REPORT_PUBLISHED"]},
          "event_time": {
            "type": "object",
            "required": ["start_utc", "end_utc", "precision"],
            "properties": {
              "start_utc": {"type": ["string", "null"]},
              "end_utc": {"type": ["string", "null"]},
              "precision": {"enum": ["second", "day", "interval", "unknown"]}
            }
          },
          "available_at_utc": {"type": "string", "format": "date-time"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "legacy_observation_ids": {"type": "array", "items": {"type": "string"}},
          "subject_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
          "object_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
          "actor_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
          "campaign_id": {"type": ["string", "null"]},
          "techniques": {"type": "array", "items": {"type": "object"}},
          "targets": {"type": "object"},
          "visibility": {"enum": ["high", "medium", "low"]},
          "outcome_observability": {"enum": ["closed_world", "bounded_open_world", "open_world"]},
          "assertion_status": {"enum": ["confirmed", "probable", "disputed", "retracted"]},
          "claim_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "upstream_claim_id": {"type": ["string", "null"]},
          "supersedes_event_id": {"type": ["string", "null"]},
          "summary_fact": {"type": "string"},
          "cohort": {"enum": ["prospective_live", "machine_backfill", "historical_case"]},
          "attack_version": {"type": ["string", "null"]},
          "generator_version": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["vulnerability", "product", "actor", "campaign", "malware", "infrastructure", "sector", "geo", "technique", "report"]},
        "id": {"type": "string"}
      }
    }
  }
}
