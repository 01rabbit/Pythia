{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pythia Tactical Episode File",
  "type": "object",
  "required": ["_schema_version", "episodes"],
  "properties": {
    "_schema_version": {"const": "1.0"},
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["episode_id", "episode_type", "entity_refs", "events", "visibility", "open"],
        "properties": {
          "episode_id": {"type": "string"},
          "episode_type": {"enum": ["vulnerability", "campaign"]},
          "entity_refs": {"type": "array"},
          "first_seen_utc": {"type": ["string", "null"]},
          "last_seen_utc": {"type": ["string", "null"]},
          "events": {"type": "array"},
          "current_objective": {"type": ["string", "null"]},
          "visibility": {"enum": ["high", "medium", "low"]},
          "open": {"type": "boolean"}
        }
      }
    }
  }
}
