{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pythia Entity Registry",
  "type": "object",
  "required": ["_schema_version", "entities"],
  "properties": {
    "_schema_version": {"const": "1.0"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "entity_type", "canonical_name", "resolution_status", "evidence_ids"],
        "properties": {
          "entity_id": {"type": "string"},
          "entity_type": {"enum": ["vulnerability", "product", "actor", "campaign", "malware", "infrastructure", "sector", "geo", "technique"]},
          "canonical_name": {"type": "string"},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "resolution_status": {"enum": ["confirmed", "proposed", "rejected"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "valid_from": {"type": ["string", "null"]},
          "valid_to": {"type": ["string", "null"]}
        }
      }
    }
  }
}
