{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pythia Historical Case Library",
  "type": "object",
  "required": ["_schema_version", "cases"],
  "properties": {
    "_schema_version": {"const": "1.0"},
    "_attack_version": {"type": "string"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "case_type", "actor_refs", "ordered_events", "source_references", "selection_bias_notes", "review_status"],
        "properties": {
          "case_id": {"type": "string"},
          "case_type": {"enum": ["campaign", "vulnerability_exploitation", "cybercrime"]},
          "time_range": {"type": "object"},
          "actor_refs": {"type": "array"},
          "campaign_refs": {"type": "array"},
          "products": {"type": "array"},
          "initial_access": {"type": "array"},
          "ordered_events": {"type": "array"},
          "targets": {"type": "object"},
          "outcomes": {"type": "array"},
          "source_references": {"type": "array"},
          "selection_bias_notes": {"type": "array", "items": {"type": "string"}},
          "review_status": {"enum": ["cited", "proposed", "rejected"]}
        }
      }
    }
  }
}
